# Ayashmart backend - copy to .env and set your local credentials.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aayash_emart
DB_USER=root
DB_PASSWORD=
DB_LOG_SQL=false

# Development only: initialize base tables and run pending migrations on startup.
DB_AUTO_MIGRATE=true

# Development image uploads. Use configured cloud storage in production.
MEDIA_STORAGE=local

# If admin already exists, leave disabled and omit the credentials below.
ADMIN_ENABLED=false

# ONE-TIME initial admin bootstrap ONLY, for a fresh local database:
# Set ADMIN_ENABLED=true and enter a NEW private username/password below.
# After the first successful admin creation, set ADMIN_ENABLED=false
# and REMOVE these credential lines from your actual .env file.

# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=CHANGE_TO_A_UNIQUE_STRONG_PASSWORD

# Encrypts courier keys, Google/Facebook secrets and the Meta token stored in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED when NODE_ENV=production.
SETTINGS_ENCRYPTION_KEY=

# Set when the backend sits behind a proxy/load balancer (correct client IPs for rate limits and Meta events).
# TRUST_PROXY=1

# Food catalog is not seeded automatically. Run manually after database setup:
# npm run seed:catalog -- SEED_AYASHMART_CATALOG


# How to use this .env file:
# 1. Copy this file to .env in the same directory.
# 2. Edit the values to match your local development environment.   

# How to start the backend server:
# 1. Install dependencies: npm install
# 2. npm run db:migrate
# 3. npm run seed:catalog -- SEED_AYASHMART_CATALOG
# 4. Start the server: npm run dev
